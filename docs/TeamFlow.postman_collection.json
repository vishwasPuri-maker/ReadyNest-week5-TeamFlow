{
  "info": {
    "name": "TeamFlow — Multi-Tenant SaaS",
    "description": "API collection for the TeamFlow backend. Run 'Login' first — it auto-saves {{accessToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "taskId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Admin\",\n  \"email\": \"new@startup.com\",\n  \"password\": \"password123\",\n  \"organizationName\": \"My Startup\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  console.log('Saved accessToken');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@acme.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        { "name": "Me", "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" } },
        { "name": "Refresh", "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh" } },
        { "name": "Logout", "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" } }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List (paginated + search)",
          "request": { "method": "GET", "url": "{{baseUrl}}/projects?page=1&limit=10&search=" }
        },
        {
          "name": "Create",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data) pm.collectionVariables.set('projectId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Q3 Launch\",\n  \"description\": \"Product launch tasks\"\n}" }
          }
        },
        { "name": "Get one", "request": { "method": "GET", "url": "{{baseUrl}}/projects/{{projectId}}" } },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects/{{projectId}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Q3 Launch (updated)\"\n}" }
          }
        },
        { "name": "Delete (admin)", "request": { "method": "DELETE", "url": "{{baseUrl}}/projects/{{projectId}}" } }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List (filter + sort)",
          "request": { "method": "GET", "url": "{{baseUrl}}/tasks?page=1&limit=10&status=TODO&priority=HIGH&sortBy=createdAt&sortOrder=desc" }
        },
        {
          "name": "Create",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data) pm.collectionVariables.set('taskId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tasks",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Draft launch email\",\n  \"projectId\": \"{{projectId}}\",\n  \"status\": \"TODO\",\n  \"priority\": \"HIGH\"\n}" }
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tasks/{{taskId}}",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"DONE\"\n}" }
          }
        },
        { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/tasks/{{taskId}}" } }
      ]
    },
    {
      "name": "Members",
      "item": [
        { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/members?page=1&limit=50" } },
        {
          "name": "Add member (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/members",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Dana Dev\",\n  \"email\": \"dana@acme.com\",\n  \"password\": \"password123\",\n  \"role\": \"MEMBER\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        { "name": "Dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/analytics/dashboard" } },
        { "name": "Activity log", "request": { "method": "GET", "url": "{{baseUrl}}/analytics/activity?page=1&limit=20" } }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload file",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/uploads",
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": [] }] }
          }
        }
      ]
    }
  ]
}
